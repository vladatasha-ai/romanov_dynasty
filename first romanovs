      box-shadow: 0 4px 6px rgba(0,0,0,0.1);
      z-index: 1000;
      border-bottom: 2px solid #ffdab9; 
    }

    .nav-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
    }

    .burger-menu {
      display: none;
      font-size: 24px;
      cursor: pointer;
      color: #900020;
      padding: 15px;
      user-select: none;
    }

    #menu1 ul.main-nav {
      margin: 0;
      padding: 0;
      list-style: none;
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      width: 100%;
