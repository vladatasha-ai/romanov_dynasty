    #menu1 ul.main-nav li {
      position: relative;
    }

    #menu1 ul.main-nav li a {
      display: block;
      padding: 15px 20px;
      font-size: 14px;
      text-decoration: none;
      font-weight: bold;
      text-transform: uppercase;
      color: #900020; 
      transition: all 0.3s ease;
    }

    #menu1 ul.main-nav li a:hover {
      background-color: #ffdab9;
      color: #333;
    }
    
    #menu1 ul.main-nav li ul {
      position: absolute;
      top: 100%;
      left: 0;
      display: none;
      min-width: 250px;
      background: #ffffff;
      box-shadow: 0 8px 16px rgba(0,0,0,0.15);
      border-radius: 0 0 10px 10px;
      overflow: hidden;
      border-top: 2px solid #007bff;
      z-index: 1001;
    }

    #menu1 ul.main-nav li:hover ul {
      display: block;
    }

    #menu1 ul.main-nav li ul li {
      width: 100%;
    }

    #menu1 ul.main-nav li ul li a {
      color: #333;
      text-transform: none;
      padding: 12px 20px;
      border-bottom: 1px solid #eee;
      font-weight: normal;
    }

    #menu1 ul.main-nav li ul li a:hover {
      background-color: #fff5ee;
      color: #900020;
      padding-left: 25px;
    }

